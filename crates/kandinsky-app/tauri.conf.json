{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kandinsky",
  "version": "0.4.3",
  "identifier": "dev.kandinsky.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["kandinsky"] } }
  },
  "bundle": {
    "active": false,
    "publisher": "alneb",
    "homepage": "https://github.com/antimajorana/kandinsky",
    "license": "AGPL-3.0-or-later",
    "resources": {
      "../../LICENSE": "licenses/AGPL-3.0.txt",
      "../../docs/THIRD-PARTY.md": "licenses/THIRD-PARTY.md",
      "../vendor/softbuffer/LICENSE-APACHE": "licenses/softbuffer/LICENSE-APACHE",
      "../vendor/softbuffer/LICENSE-MIT": "licenses/softbuffer/LICENSE-MIT",
      "../vendor/kreuzberg-tesseract/LICENSE": "licenses/kreuzberg-tesseract/LICENSE",
      "../../ui/src/assets/fonts/kandinsky-term-symbols-OFL.txt": "licenses/kandinsky-term-symbols-OFL.txt"
    },
    "category": "Productivity",
    "shortDescription": "One fast desktop workspace over plain files",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "linux": {
      "deb": { "files": {
        "/usr/bin/kandinsky": "../../target/release/kandinsky",
        "/usr/bin/kandinsky-capture": "../../target/release/kandinsky-capture",
        "/usr/bin/kandinsky-quick-capture": "../../packaging/kandinsky-quick-capture",
        "/usr/share/applications/kandinsky-capture.desktop": "../../packaging/kandinsky-capture.desktop",
        "/usr/share/applications/kandinsky-capture-box.desktop": "../../packaging/kandinsky-capture-box.desktop",
        "/usr/share/icons/hicolor/scalable/apps/kandinsky.svg": "../../packaging/icon/kandinsky.svg"
      } },
      "appimage": { "files": { "/usr/bin/kandinsky-capture": "../../target/release/kandinsky-capture" } },
      "rpm": { "files": {
        "/usr/bin/kandinsky": "../../target/release/kandinsky",
        "/usr/bin/kandinsky-capture": "../../target/release/kandinsky-capture",
        "/usr/bin/kandinsky-quick-capture": "../../packaging/kandinsky-quick-capture",
        "/usr/share/applications/kandinsky-capture.desktop": "../../packaging/kandinsky-capture.desktop",
        "/usr/share/applications/kandinsky-capture-box.desktop": "../../packaging/kandinsky-capture-box.desktop",
        "/usr/share/icons/hicolor/scalable/apps/kandinsky.svg": "../../packaging/icon/kandinsky.svg"
      } }
    }
  }
}
