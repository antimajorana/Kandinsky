[Desktop Entry]
Type=Application
Name=Kandinsky Capture (the box itself)
Comment=Not for the menu: names the capture box's binary so KWin lets it take a picture of the window you were on
Exec=/usr/bin/kandinsky-capture
Icon=kandinsky
NoDisplay=true
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
