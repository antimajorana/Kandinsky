#!/usr/bin/env sh
# Global quick capture (bind a key to "Kandinsky Capture" in System Settings → Shortcuts):
# a small box above everything — type, Enter, gone. docs/CAPTURE.md.
#
#   KANDINSKY_WORKSPACE=/path/to/vault   the vault it writes to (default: the one opened last);
#                                    the box can also switch vault itself
#   KANDINSKY_CAPTURE=webview            the older box drawn by the desktop app (WebKit; slower to open)
#   KANDINSKY_CAPTURE=dialog             use the plain one-line dialog instead of Kandinsky's own box
#
# The box is kandinsky-capture: a native window, no web view, so it opens at once. Without the app (or when asked), the old way:
# a one-line kdialog prompt and `kandinsky capture`, which writes to disk with or without Kandinsky open.
# Started from a menu or a shortcut, PATH may lack ~/.cargo/bin (where install.sh puts the binaries).
PATH="$PATH:$HOME/.cargo/bin"
if [ "${KANDINSKY_CAPTURE:-box}" = "box" ] && command -v kandinsky-capture >/dev/null 2>&1; then
  exec kandinsky-capture ${KANDINSKY_WORKSPACE:+"$KANDINSKY_WORKSPACE"}
fi
if [ "${KANDINSKY_CAPTURE:-box}" != "dialog" ] && command -v kandinsky-app >/dev/null 2>&1; then
  if [ -n "${KANDINSKY_WORKSPACE:-}" ]; then exec kandinsky-app --capture "$KANDINSKY_WORKSPACE"; fi
  exec kandinsky-app --capture
fi
text=$(kdialog --title "Kandinsky capture" --inputbox "→ today's log" "" 2>/dev/null) || exit 0
[ -n "$text" ] || exit 0
if out=$(kandinsky ${KANDINSKY_WORKSPACE:+--workspace "$KANDINSKY_WORKSPACE"} capture "$text" 2>&1); then
  notify-send -a Kandinsky -t 1500 "Captured" "$text" 2>/dev/null || true
else
  kdialog --error "Kandinsky capture failed:\n$out"
fi
